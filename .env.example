# =====================================================
# Artist Metrics Dashboard — Variables de Entorno
# Copia este archivo como .env y completa los valores
# =====================================================

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key

# Instagram / Meta App (https://developers.facebook.com)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# App
BASE_URL=http://localhost:3000
PORT=3000

# =====================================================
# PRODUCCIÓN EN VERCEL:
# Agrega las mismas variables en:
# Vercel Dashboard > Settings > Environment Variables
# Cambia BASE_URL a tu dominio de Vercel
# =====================================================
